[Unit]
Description=BatchForge Patroni PostgreSQL controller
After=network-online.target batchforge-etcd.service
Wants=network-online.target

[Service]
Type=simple
User=postgres
Group=postgres
ExecStart=/opt/batchforge-ha/venv/bin/patroni /etc/batchforge-ha/patroni.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=process
LimitNOFILE=65536
UMask=0077

[Install]
WantedBy=multi-user.target
