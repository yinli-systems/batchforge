# Generate independent keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
DATABASE_URL=postgresql://batchforge:replace-me@127.0.0.1:55432/batchforge
BATCHFORGE_API_KEY=replace-with-random-tenant-key
BATCHFORGE_WORKER_TOKEN=replace-with-independent-random-worker-key
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
# Optional additional served IDs. Each uploaded batch must select exactly one model.
# MODEL_NAMES_JSON='["Qwen/Qwen2.5-7B-Instruct","openai/gpt-oss-120b"]'

# For Compose: use only URL-safe characters in POSTGRES_PASSWORD.
POSTGRES_PASSWORD=replace-with-random-url-safe-database-password
FRONTEND_DIR=frontend
# Native defaults; Compose overrides service DNS names.
CONTROL_PLANE_URL=http://127.0.0.1:8000
# Optional ordered control origins; credentials only go to operator-configured URLs.
# CONTROL_PLANE_URLS=http://127.0.0.1:8080,http://127.0.0.1:8082,http://127.0.0.1:8083
# Apply migration v2 separately before enabling the single-call SQL path.
SQL_COMPLETION_ENABLED=false
# Apply additive migration v3 and deploy compatible replicas before enabling.
SQL_CLAIM_ENABLED=false
INFERENCE_BASE_URLS=http://127.0.0.1:8001
ENGINE_MAX_MODEL_LEN=2048
ENGINE_MAX_NUM_SEQS=8
ENGINE_GPU_MEMORY_UTILIZATION=0.06
# Optional app-owned directory containing generation_config.json; unset keeps the model defaults.
# ENGINE_GENERATION_CONFIG=/root/batchforge-runtime/generation-configs/eos-151645
WORKER_MAX_INFLIGHT=8
WORKER_TOKEN_BUDGET=16384
MAX_OUTPUT_TOKENS=512
# Additive features: roll out compatible code, migrate, then enable.
SQL_RECOVERY_ENABLED=false
RECOVERY_TASK_LIMIT=100
RECOVERY_BATCH_LIMIT=8
SCHEDULER_POLICY=legacy
SCHEDULER_AGING_SECONDS=60
SCHEDULER_WORKER_FRESHNESS_SECONDS=60
BLOB_STORAGE_BACKEND=inline
BLOB_STORAGE_BUCKET=
MAX_STORED_INPUT_BYTES_PER_TENANT=268435456
UPLOAD_RESERVATION_SECONDS=300
INPUT_RETENTION_SECONDS=86400
BLOB_GC_ENABLED=false
# For S3, inject AWS_ENDPOINT_URL_S3/AWS_REGION/AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY privately. Worker profiles use SCHEDULER_PROFILE_JSON.
